---
import "@/styles/snf.css";

const WA = "https://wa.me/14079859084?text=Hola%20Natha%2C%20quiero%20info%20de%20tus%20planes%20de%20entrenamiento";
const CAL = "https://calendly.com/ceo-lytmanagement/30min";
const IG = "https://instagram.com/soynathafit";
const TT = "https://tiktok.com/@soynathafit";
const FB = "https://www.facebook.com/profile.php?id=61590926841340";
const YT_ID = "PRT3sN5klk0";
const YT = `https://youtu.be/${YT_ID}`;

// Iconos de línea (aesthetic, no emojis)
const svg = (p: string) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${p}</svg>`;
const ic = {
  star: svg(`<path d="M12 3l2.4 5.6L20.4 9l-4.2 4 1.1 6L12 16.1 6.7 19l1.1-6-4.2-4 6-.4L12 3Z"/>`),
  medal: svg(`<circle cx="12" cy="9" r="6"/><path d="M9.2 14.3 7.5 22l4.5-2.7L16.5 22l-1.7-7.7"/>`),
  target: svg(`<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3.4"/>`),
  bolt: svg(`<path d="M13 2 4.5 13H11l-1 9 8.5-11H12l1-9Z"/>`),
  heart: svg(`<path d="M20.4 5.1a5 5 0 0 0-7.1 0l-1.3 1.3-1.3-1.3a5 5 0 1 0-7.1 7.1L12 21l9.4-8.8a5 5 0 0 0-1-7.1Z"/><path d="M3.5 12.5h3l1.5-3 2 5 1.5-2h3"/>`),
  trophy: svg(`<path d="M8 21h8M12 17v4M7 4h10v4a5 5 0 0 1-10 0V4Z"/><path d="M7 5H4v2a3 3 0 0 0 3 3M17 5h3v2a3 3 0 0 1-3 3"/>`),
  flame: svg(`<path d="M12 3c0 3-3 4-3 7a3 3 0 0 0 6 0c0-1-1-2-1-3 1 .6 3 2.6 3 5a5 5 0 0 1-10 0c0-4 3-6 5-9Z"/>`),
  dumbbell: svg(`<path d="m6.5 6.5 11 11"/><path d="m21 21-1-1"/><path d="m3 3 1 1"/><path d="m18 22 4-4"/><path d="m2 6 4-4"/><path d="m3 10 7-7"/><path d="m14 21 7-7"/>`),
  leaf: svg(`<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.5 19 2c1 2 2 4.2 2 8 0 5.5-4.8 10-10 10Z"/><path d="M2 21c0-3 1.9-5.4 5.1-6"/>`),
  chat: svg(`<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z"/>`),
  phone: svg(`<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"/>`),
  play: svg(`<path d="M5 4.5v15a1 1 0 0 0 1.5.9l13-7.5a1 1 0 0 0 0-1.8l-13-7.5A1 1 0 0 0 5 4.5Z" fill="currentColor" stroke="none"/>`),
  arrow: svg(`<path d="M7 17 17 7M9 7h8v8"/>`),
  calendar: svg(`<rect x="3" y="4.5" width="18" height="16" rx="2.5"/><path d="M3 9h18M8 2.5v4M16 2.5v4"/>`),
};

// WhatsApp (marca) para el botón flotante
const waBrand = `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm5.79 14.06c-.25.69-1.45 1.32-1.99 1.4-.51.08-1.15.11-1.86-.12-.43-.14-.98-.32-1.69-.62-2.97-1.28-4.9-4.27-5.05-4.47-.15-.2-1.2-1.6-1.2-3.05 0-1.45.76-2.16.03-2.94.2-.22.45-.27.6-.27.15 0 .3 0 .43.01.14.01.32-.05.5.38.18.44.62 1.51.67 1.62.05.11.08.24.02.38-.07.14-.1.23-.21.36-.11.13-.23.29-.32.38-.11.11-.22.23-.1.45.12.22.55.91 1.18 1.47.81.73 1.5.95 1.71 1.06.21.11.34.09.46-.05.13-.14.54-.62.68-.84.14-.22.28-.18.48-.11.2.07 1.25.59 1.46.7.21.11.36.16.41.25.05.09.05.52-.13 1.02Z"/></svg>`;

// Iconos de marca (redes) — fill, no stroke
const brandSvg = (p: string) =>
  `<svg viewBox="0 0 24 24" fill="currentColor">${p}</svg>`;
const social = [
  {
    name: "Instagram",
    handle: "@soynathafit",
    href: IG,
    cls: "ig",
    ic: brandSvg(`<path d="M12 2.2c3.2 0 3.6 0 4.9.07 1.2.06 1.8.26 2.2.43.6.2 1 .47 1.4.9.43.4.7.8.9 1.4.17.4.37 1 .43 2.2.07 1.3.07 1.7.07 4.9s0 3.6-.07 4.9c-.06 1.2-.26 1.8-.43 2.2-.2.6-.47 1-.9 1.4-.4.43-.8.7-1.4.9-.4.17-1 .37-2.2.43-1.3.07-1.7.07-4.9.07s-3.6 0-4.9-.07c-1.2-.06-1.8-.26-2.2-.43-.6-.2-1-.47-1.4-.9-.43-.4-.7-.8-.9-1.4-.17-.4-.37-1-.43-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.07-4.9c.06-1.2.26-1.8.43-2.2.2-.6.47-1 .9-1.4.4-.43.8-.7 1.4-.9.4-.17 1-.37 2.2-.43C8.4 2.2 8.8 2.2 12 2.2Zm0 1.8c-3.1 0-3.5 0-4.7.07-1.1.05-1.7.24-2.1.4-.5.2-.9.43-1.3.82-.4.4-.63.8-.82 1.3-.16.4-.35 1-.4 2.1C2.6 9.9 2.6 10.3 2.6 12s0 2.1.07 3.3c.05 1.1.24 1.7.4 2.1.2.5.43.9.82 1.3.4.4.8.63 1.3.82.4.16 1 .35 2.1.4 1.2.07 1.6.07 4.7.07s3.5 0 4.7-.07c1.1-.05 1.7-.24 2.1-.4.5-.2.9-.43 1.3-.82.4-.4.63-.8.82-1.3.16-.4.35-1 .4-2.1.07-1.2.07-1.6.07-3.3s0-2.1-.07-3.3c-.05-1.1-.24-1.7-.4-2.1-.2-.5-.43-.9-.82-1.3-.4-.4-.8-.63-1.3-.82-.4-.16-1-.35-2.1-.4C15.5 4 15.1 4 12 4Zm0 3.06A4.94 4.94 0 1 1 12 17a4.94 4.94 0 0 1 0-9.94Zm0 1.8a3.14 3.14 0 1 0 0 6.28 3.14 3.14 0 0 0 0-6.28Zm5.15-3.3a1.15 1.15 0 1 1 0 2.3 1.15 1.15 0 0 1 0-2.3Z"/>`),
  },
  {
    name: "TikTok",
    handle: "@soynathafit",
    href: TT,
    cls: "tt",
    ic: brandSvg(`<path d="M16.6 5.8a4.3 4.3 0 0 1-1-2.8h-3v12.3a2.5 2.5 0 1 1-2.5-2.5c.26 0 .5.04.74.1V9.8a5.6 5.6 0 0 0-.74-.05 5.5 5.5 0 1 0 5.5 5.5V9.0a7.2 7.2 0 0 0 4.2 1.35V7.3a4.3 4.3 0 0 1-3.2-1.5Z"/>`),
  },
  {
    name: "Facebook",
    handle: "Soynathafit",
    href: FB,
    cls: "fb",
    ic: brandSvg(`<path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12Z"/>`),
  },
];

const offers = [
  {
    n: "01",
    title: "Tu plan, no uno cualquiera",
    body: "¿Bajar grasa o ganar músculo? ¿Gym o en casa con lo que tengas? Te diseño el entrenamiento exacto para tu cuerpo, tu nivel y tu rutina real. Nada copiado de internet.",
    tags: ["Gym o casa", "Pérdida de grasa", "Masa muscular"],
    feature: true,
  },
  {
    n: "02",
    title: "Comer rico sin pasar hambre",
    body: "Tu plan de alimentación cambia cada 15 días para que tu cuerpo no se acostumbre y los resultados no se frenen nunca. Comida real, no castigo.",
  },
  {
    n: "03",
    title: "Yo, encima tuyo cada día",
    body: "Te escribo a diario, reviso cómo vas y te empujo justo cuando estás por aflojar. Aquí no desapareces del mapa: entrenas conmigo, no sola.",
  },
];

const includes = [
  { ic: ic.dumbbell, t: "Rutinas a tu medida", s: "Para gym o casa, con tu nivel y tu equipo. Sin relleno." },
  { ic: ic.leaf, t: "Alimentación viva", s: "Renovada cada 15 días. Comida real, cero dietas de hambre." },
  { ic: ic.chat, t: "Chequeo diario", s: "Te escribo cada día para que no aflojes ni un día." },
  { ic: ic.phone, t: "Llamada semanal", s: "Vemos resultados, celebramos y ajustamos lo que toque." },
];

const creds = [
  { ic: ic.star, t: "Fundadora de LYT", s: "Mi método de bienestar y transformación", feature: true, href: "https://www.thelytmethod.com" },
  { ic: ic.medal, t: "Entrenadora Personal certificada", s: "FEDA España · Sala Polivalente" },
  { ic: ic.target, t: "Coaching Deportivo Internacional", s: "Avalado por ACI" },
  { ic: ic.bolt, t: "Entrenamiento Funcional Internacional", s: "Federación de Aeróbica" },
  { ic: ic.heart, t: "Salud y actividad física", s: "Inst. Panamericano + Universidad del Zulia" },
  { ic: ic.trophy, t: "Premio Gatorade 2013", s: "Talento regional · Step y ritmos latinos" },
  { ic: ic.flame, t: "Creadora de retos de transformación", s: "Reto 12 semanas · Micro Reto 6 semanas" },
];

const beforeAfter = [
  { title: "Constancia que se nota", who: "Clienta SoyNathaFit", img: "/images/snf/resultado-2.jpg" },
  { title: "El cambio empezó por decidir", who: "Clienta SoyNathaFit", img: "/images/snf/resultado-1.jpg" },
  { title: "Fuerte por dentro y por fuera", who: "Clienta SoyNathaFit", img: "/images/snf/resultado-3.jpg" },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SoyNathaFit</title>
    <meta
      name="description"
      content="Planes de entrenamiento personalizados para gym o casa, alimentación que cambia cada 15 días, chequeo diario y seguimiento semanal con Nathaly Díaz."
    />
    <meta name="theme-color" content="#7C3CF0" />
    <link rel="icon" href="/logos/favicon.png" />
    <meta property="og:title" content="SŌYNATHAFIT · Entrenamiento personal" />
    <meta
      property="og:description"
      content="Tu transformación con acompañamiento real. Eyes on the prize."
    />
    <meta property="og:type" content="website" />
  </head>
  <body class="snf">
    <!-- HEADER -->
    <header class="snf-header">
      <div class="wrap">
        <a class="snf-header__logo" href="#top" aria-label="SoyNathaFit inicio">
          <img src="/logos/snf-violet.png" alt="SoyNathaFit" />
        </a>
        <nav class="snf-nav">
          <a href="#sobre-mi">Sobre mí</a>
          <a href="#ofrezco">Lo que ofrezco</a>
          <a href="#incluye">Cómo funciona</a>
          <a href="#resultados">Resultados</a>
          <a href="#comunidad">Comunidad</a>
          <a href="/planes">Planes</a>
        </nav>
        <a class="btn btn-primary" href="/planes">Ver planes</a>
        <button class="snf-burger" aria-label="Menú">
          <span></span><span></span><span></span>
        </button>
      </div>
    </header>

    <!-- HERO -->
    <section class="snf-hero" id="top">
      <div class="snf-hero__bg" style="background-image:url('/images/snf/hero.jpg')"></div>
      <div class="wrap">
        <div class="snf-hero__inner">
          <p class="snf-hero__kicker">Eyes on the prize</p>
          <h1>
            Tu meta no se<br />negocia
            <span class="brush">dáale</span>
          </h1>
          <p class="snf-hero__lead">
            Nada de rutinas copiadas ni dietas de hambre. Yo te armo el plan, te
            reviso cada día y no te suelto hasta que lo logres. Tú pones la
            decisión, yo pongo el método.
          </p>
          <div class="snf-hero__cta">
            <a class="btn btn-primary btn-lg" href={CAL} target="_blank" rel="noopener">
              <span class="btn__ic" set:html={ic.calendar} />
              Agenda una llamada conmigo
            </a>
          </div>
          <div class="snf-hero__stats">
            <div class="snf-stat">
              <div class="snf-stat__num">+15</div>
              <div class="snf-stat__label">años entrenando mujeres</div>
            </div>
            <div class="snf-stat">
              <div class="snf-stat__num">100%</div>
              <div class="snf-stat__label">planes personalizados</div>
            </div>
            <div class="snf-stat">
              <div class="snf-stat__num">7/7</div>
              <div class="snf-stat__label">acompañamiento diario</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- MARQUEE -->
    <div class="snf-marquee" aria-hidden="true">
      <div class="snf-marquee__track">
        <span>no te pares</span><span>sigue sigue sigue</span><span>llega a la meta</span>
        <span>eyes on the prize</span><span>dáale</span>
        <span>no te pares</span><span>sigue sigue sigue</span><span>llega a la meta</span>
        <span>eyes on the prize</span><span>dáale</span>
      </div>
    </div>

    <!-- SOBRE MÍ / CREDENCIALES -->
    <section class="snf-section" id="sobre-mi">
      <div class="wrap snf-about">
        <div class="snf-about__photo reveal-up">
          <img src="/images/snf/nathaly.jpg" alt="Nathaly Díaz, entrenadora personal" />
          <div class="snf-about__badge">Nathaly Díaz · Entrenadora personal</div>
        </div>
        <div class="reveal-up">
          <p class="eyebrow">La entrenadora</p>
          <h2>
            Más de 15 años
            <span class="brush violet">transformando vidas</span>
          </h2>
          <p class="lead">
            Soy Nathaly. Empecé porque me cansé de ver a mujeres rendirse con
            planes genéricos que nunca fueron pensados para ellas. Llevo más de
            15 años entrenando de verdad: con formación, con método y con
            cariño. También soy fundadora de LYT, mi método de bienestar. Aquí
            no entrenas sola — entrenas conmigo.
          </p>
          <div class="snf-creds">
            {creds.map((c) => {
              const Tag = c.href ? "a" : "div";
              return (
                <Tag
                  class={`snf-cred${c.feature ? " feature" : ""}${c.href ? " is-link" : ""}`}
                  {...(c.href ? { href: c.href, target: "_blank", rel: "noopener" } : {})}
                >
                  <div class="snf-cred__ic" set:html={c.ic} />
                  <div>
                    <div class="snf-cred__t">{c.t}</div>
                    <div class="snf-cred__s">{c.s}</div>
                  </div>
                  {c.href && <span class="snf-cred__go" set:html={ic.arrow} />}
                </Tag>
              );
            })}
          </div>
          <div class="snf-cta-row reveal-up">
            <a class="btn btn-cta btn-lg" href="/planes">
              Hoy me elijo primero
              <span class="btn__go" set:html={ic.arrow} />
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- MISIÓN -->
    <section class="snf-section dark">
      <div class="wrap snf-section__head center reveal-up">
        <p class="eyebrow on-dark">Mi misión</p>
        <h2>
          Que entrenar y comer dejen de
          <span class="brush on-dark">ser una batalla</span>
        </h2>
        <p class="lead">
          Estoy harta de las dietas imposibles y las rutinas que te dejan tirada
          a mitad de camino. Tu plan se adapta a tu vida real, no al revés. Y
          cuando quieras rendirte, ahí voy a estar yo para no dejarte. Tu única
          rival eres tú — y juntas te ganamos.
        </p>
        <div class="snf-cta-row reveal-up">
          <a class="btn btn-cta btn-lg" href="/planes">
            Estoy lista para cambiar
            <span class="btn__go" set:html={ic.arrow} />
          </a>
        </div>
      </div>
    </section>

    <!-- LO QUE OFREZCO -->
    <section class="snf-section alt" id="ofrezco">
      <div class="wrap">
        <div class="snf-section__head reveal-up">
          <p class="eyebrow">Lo que ofrezco</p>
          <h2>
            Un sistema completo
            <span class="brush">para que llegues</span>
          </h2>
          <p class="lead">
            No te vendo una rutina suelta. Te doy entrenamiento, comida y a mí
            encima tuyo cada día. Todo junto, todo apuntando a tu meta.
          </p>
        </div>
        <div class="snf-offer-grid">
          {offers.map((o) => (
            <div class={`snf-offer reveal-up${o.feature ? " feature" : ""}`}>
              {o.feature ? (
                <>
                  <div>
                    <div class="snf-offer__num">{o.n}</div>
                    <h3>{o.title}</h3>
                    <div class="snf-offer__tags">
                      {o.tags.map((t) => <span class="snf-tag">{t}</span>)}
                    </div>
                  </div>
                  <p>{o.body}</p>
                </>
              ) : (
                <>
                  <div class="snf-offer__num">{o.n}</div>
                  <h3>{o.title}</h3>
                  <p>{o.body}</p>
                </>
              )}
            </div>
          ))}
        </div>
        <div class="snf-cta-row reveal-up">
          <a class="btn btn-cta btn-lg" href="/planes">
            Mi momento es ahora
            <span class="btn__go" set:html={ic.arrow} />
          </a>
        </div>
      </div>
    </section>

    <!-- CÓMO FUNCIONA / INCLUYE -->
    <section class="snf-section dark" id="incluye">
      <div class="wrap">
        <div class="snf-section__head reveal-up">
          <p class="eyebrow on-dark">Cómo funciona</p>
          <h2>
            Todo lo que incluye
            <span class="brush on-dark">tu plan</span>
          </h2>
        </div>
        <div class="snf-includes">
          {includes.map((i) => (
            <div class="snf-inc reveal-up">
              <div class="snf-inc__ic" set:html={i.ic} />
              <h3>{i.t}</h3>
              <p>{i.s}</p>
            </div>
          ))}
        </div>
        <div class="snf-cta-row reveal-up">
          <a class="btn btn-cta btn-lg" href="/planes">
            Elijo mi mejor versión
            <span class="btn__go" set:html={ic.arrow} />
          </a>
        </div>
      </div>
    </section>

    <!-- RESULTADOS -->
    <section class="snf-section" id="resultados">
      <div class="wrap">
        <div class="snf-section__head reveal-up">
          <p class="eyebrow">Resultados reales</p>
          <h2>
            Mujeres que ya le
            <span class="brush">dieron</span>
          </h2>
          <p class="lead">
            Ninguna empezó lista. Empezaron y ya. La próxima en esta lista
            puedes ser tú.
          </p>
        </div>
        <div class="snf-ba-grid">
          {beforeAfter.map((b) => (
            <div class="snf-ba reveal-up">
              <div class="snf-ba__imgs">
                <img class="snf-ba__img" src={b.img} alt={`Resultado real · ${b.who}`} loading="lazy" />
                <span class="snf-ba__tag snf-ba__tag--a">Antes</span>
                <span class="snf-ba__tag snf-ba__tag--b">Después</span>
              </div>
              <div class="snf-ba__body">
                <h3>{b.title}</h3>
                <span>{b.who}</span>
              </div>
            </div>
          ))}
        </div>
        <div class="snf-cta-row reveal-up">
          <a class="btn btn-cta btn-lg" href="/planes">
            La próxima soy yo
            <span class="btn__go" set:html={ic.arrow} />
          </a>
        </div>
      </div>
    </section>

    <!-- YOUTUBE + REDES -->
    <section class="snf-section dark" id="comunidad">
      <div class="wrap">
        <div class="snf-section__head reveal-up">
          <p class="eyebrow on-dark">Mi comunidad</p>
          <h2>
            Entrena conmigo
            <span class="brush">cada día</span>
          </h2>
          <p class="lead">
            Tips, rutinas y motivación real en mis redes. Mira el último video y
            sígueme donde quieras — esto no para.
          </p>
        </div>
        <div class="snf-comu">
          <a
            class="snf-yt reveal-up"
            href={YT}
            target="_blank"
            rel="noopener"
            aria-label="Ver mi canal de YouTube"
          >
            <img
              class="snf-yt__thumb"
              src={`https://i.ytimg.com/vi/${YT_ID}/hqdefault.jpg`}
              alt="Último video de YouTube de SoyNathaFit"
              loading="lazy"
            />
            <span class="snf-yt__play" set:html={ic.play} />
            <span class="snf-yt__tag">YouTube · Nuevo video</span>
          </a>
          <div class="snf-social">
            {social.map((s) => (
              <a
                class={`snf-soc snf-soc--${s.cls} reveal-up`}
                href={s.href}
                target="_blank"
                rel="noopener"
              >
                <span class="snf-soc__ic" set:html={s.ic} />
                <span class="snf-soc__txt">
                  <strong>{s.name}</strong>
                  <span>{s.handle}</span>
                </span>
