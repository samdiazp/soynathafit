---
import "@/styles/snf.css";

const WA = "https://wa.me/14079859084?text=Hola%20Natha%2C%20quiero%20empezar%20con%20tu%20plan%20de%20entrenamiento";
const CAL = "https://calendly.com/ceo-lytmanagement/30min";
const IG = "https://instagram.com/soynathafit";

const svg = (p: string) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${p}</svg>`;
const ic = {
  check: svg(`<path d="M20 6 9 17l-5-5"/>`),
  calendar: svg(`<rect x="3" y="4.5" width="18" height="16" rx="2.5"/><path d="M3 9h18M8 2.5v4M16 2.5v4"/>`),
  arrow: svg(`<path d="M7 17 17 7M9 7h8v8"/>`),
  dumbbell: svg(`<path d="m6.5 6.5 11 11"/><path d="m21 21-1-1"/><path d="m3 3 1 1"/><path d="m18 22 4-4"/><path d="m2 6 4-4"/><path d="m3 10 7-7"/><path d="m14 21 7-7"/>`),
  leaf: svg(`<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.5 19 2c1 2 2 4.2 2 8 0 5.5-4.8 10-10 10Z"/><path d="M2 21c0-3 1.9-5.4 5.1-6"/>`),
  chat: svg(`<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z"/>`),
  phone: svg(`<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"/>`),
};

const waBrand = `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm5.79 14.06c-.25.69-1.45 1.32-1.99 1.4-.51.08-1.15.11-1.86-.12-.43-.14-.98-.32-1.69-.62-2.97-1.28-4.9-4.27-5.05-4.47-.15-.2-1.2-1.6-1.2-3.05 0-1.45.76-2.16.03-2.94.2-.22.45-.27.6-.27.15 0 .3 0 .43.01.14.01.32-.05.5.38.18.44.62 1.51.67 1.62.05.11.08.24.02.38-.07.14-.1.23-.21.36-.11.13-.23.29-.32.38-.11.11-.22.23-.1.45.12.22.55.91 1.18 1.47.81.73 1.5.95 1.71 1.06.21.11.34.09.46-.05.13-.14.54-.62.68-.84.14-.22.28-.18.48-.11.2.07 1.25.59 1.46.7.21.11.36.16.41.25.05.09.05.52-.13 1.02Z"/></svg>`;

const includes = [
  { ic: ic.dumbbell, t: "Rutinas a tu medida", s: "Para gym o casa, con tu nivel y tu equipo. Sin relleno." },
  { ic: ic.leaf, t: "Alimentación viva", s: "Renovada cada 15 días. Comida real, cero dietas de hambre." },
  { ic: ic.chat, t: "Chequeo diario", s: "Te escribo cada día para que no aflojes ni un día." },
  { ic: ic.phone, t: "Llamada semanal", s: "Vemos resultados, celebramos y ajustamos lo que toque." },
];

const features = [
  "Plan de entrenamiento 100% personalizado (gym o casa)",
  "Enfoque en tu meta: bajar grasa o ganar músculo",
  "Plan de alimentación que cambia cada 15 días",
  "Chequeo diario por WhatsApp conmigo",
  "Llamada semanal de seguimiento y ajustes",
  "Acompañamiento real: no entrenas sola",
];

const plans = [
  {
    name: "Mensual",
    price: "99",
    unit: "/mes",
    tagline: "Empieza sin compromiso largo.",
    note: "Pago mes a mes. Renuevas cuando quieras.",
    feature: false,
  },
  {
    name: "Programa 12 semanas",
    price: "250",
    unit: "pago único",
    tagline: "El tiempo donde de verdad se ven los cambios.",
    note: "Equivale a ~$83/mes · Ahorras $47 vs. mensual.",
    badge: "Mejor valor",
    feature: true,
  },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SoyNathaFit · Planes</title>
    <meta
      name="description"
      content="Planes de entrenamiento personal con Nathaly Díaz: mensual o programa de 12 semanas. Rutinas a tu medida, alimentación que cambia cada 15 días, chequeo diario y llamada semanal."
    />
    <meta name="theme-color" content="#7C3CF0" />
    <link rel="icon" href="/logos/favicon.png" />
  </head>
  <body class="snf">
    <!-- HEADER -->
    <header class="snf-header">
      <div class="wrap">
        <a class="snf-header__logo" href="/" aria-label="SoyNathaFit inicio">
          <img src="/logos/snf-violet.png" alt="SoyNathaFit" />
        </a>
        <nav class="snf-nav">
          <a href="/#sobre-mi">Sobre mí</a>
          <a href="/#ofrezco">Lo que ofrezco</a>
          <a href="/#incluye">Cómo funciona</a>
          <a href="/#resultados">Resultados</a>
          <a href="/planes" class="is-active">Planes</a>
        </nav>
        <a class="btn btn-primary" href="/planes">Ver planes</a>
        <button class="snf-burger" aria-label="Menú">
          <span></span><span></span><span></span>
        </button>
      </div>
    </header>

    <!-- HERO PLANES -->
    <section class="snf-plans-hero">
      <div class="wrap snf-section__head center reveal-up">
        <p class="eyebrow on-dark">Planes y precios</p>
        <h1>
          Un solo programa.
          <span class="brush on-dark">Tú eliges cómo</span>
        </h1>
        <p class="lead">
          El mismo método completo, dos formas de empezar. Sin letras chiquitas:
          entrenas conmigo, comes bien y te acompaño cada día hasta tu meta.
        </p>
      </div>
    </section>

    <!-- PRICING -->
    <section class="snf-section alt">
      <div class="wrap">
        <div class="snf-plans">
          {plans.map((p) => (
            <div class={`snf-plan reveal-up${p.feature ? " feature" : ""}`}>
              {p.badge && <span class="snf-plan__badge">{p.badge}</span>}
              <div class="snf-plan__name">{p.name}</div>
              <p class="snf-plan__tagline">{p.tagline}</p>
              <div class="snf-plan__price">
                <span class="snf-plan__cur">$</span>
                <span class="snf-plan__amt">{p.price}</span>
                <span class="snf-plan__unit">{p.unit}</span>
              </div>
              <div class="snf-plan__note">{p.note}</div>
              <ul class="snf-plan__list">
                {features.map((f) => (
                  <li>
                    <span class="snf-plan__chk" set:html={ic.check} />
                    {f}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <div class="snf-cta-row reveal-up">
          <a class="btn btn-cta btn-lg" href={CAL} target="_blank" rel="noopener">
            <span class="btn__ic" set:html={ic.calendar} />
            Agenda una llamada conmigo
          </a>
          <a class="btn btn-wa btn-lg" href={WA} target="_blank" rel="noopener">
            <span class="btn__ic" set:html={waBrand} />
            Escríbeme por WhatsApp
          </a>
        </div>
        <p class="snf-plans-foot reveal-up">
          ¿Dudas antes de empezar? Escríbeme por WhatsApp y lo vemos juntas.
        </p>
      </div>
    </section>

    <!-- TODO INCLUYE -->
    <section class="snf-section dark">
      <div class="wrap">
        <div class="snf-section__head reveal-up">
          <p class="eyebrow on-dark">Lo mismo para los dos</p>
          <h2>
            Todo lo que incluye
            <span class="brush on-dark">tu plan</span>
          </h2>
          <p class="lead">
            No importa cómo pagues: recibes el sistema completo. Entrenamiento,
            comida y a mí pendiente de ti cada día.
          </p>
        </div>
        <div class="snf-includes">
          {includes.map((i) => (
            <div class="snf-inc reveal-up">
              <div class="snf-inc__ic" set:html={i.ic} />
              <h3>{i.t}</h3>
              <p>{i.s}</p>
            </div>
          ))}
        </div>
        <div class="snf-cta-row reveal-up">
          <a class="btn btn-cta btn-lg" href={CAL} target="_blank" rel="noopener">
            Agenda una llamada conmigo
            <span class="btn__go" set:html={ic.arrow} />
          </a>
        </div>
      </div>
    </section>

    <!-- CTA FINAL -->
    <section class="snf-final">
      <div class="wrap">
        <p class="eyebrow on-dark" style="justify-content:center;color:#fff;">Empieza hoy</p>
        <h2>
          Tu mejor versión está
          <span class="brush on-dark" style="color:#fff;">esperándote</span>
        </h2>
        <p>
          Agenda tu llamada conmigo y armamos tu plan hoy. Nada de "el lunes
          empiezo". Dáale: no te pares, sigue, sigue, sigue.
        </p>
        <div class="snf-final__cta">
          <a class="btn btn-light btn-lg" href={CAL} target="_blank" rel="noopener">
            <span class="btn__ic" set:html={ic.calendar} />
            Agenda una llamada conmigo
          </a>
          <a class="btn btn-outline btn-lg" href={IG} target="_blank" rel="noopener">
            Sígueme en Instagram
          </a>
        </div>
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="snf-footer">
      <div class="wrap">
        <div class="snf-footer__top">
          <div>
            <img src="/logos/snf-white.png" alt="SoyNathaFit" />
            <p class="snf-footer__tag">
              Entrenamiento personal con acompañamiento real. Tu transformación,
              con método y con corazón.
            </p>
            <div class="snf-footer__social">
              <a href={IG} target="_blank" rel="noopener" aria-label="Instagram">IG</a>
              <a href={WA} target="_blank" rel="noopener" aria-label="WhatsApp">WA</a>
            </div>
          </div>
        </div>
        <div class="snf-footer__bottom">
          <span>© 2026 SoyNathaFit · Nathaly Díaz</span>
          <span>Hecho con disciplina y cariño</span>
        </div>
      </div>
    </footer>

    <!-- WHATSAPP FLOTANTE -->
    <a
      class="snf-fab"
      href={WA}
      target="_blank"
      rel="noopener"
      aria-label="Escríbeme por WhatsApp"
    >
      <span class="snf-fab__ic" set:html={waBrand} />
      <span class="snf-fab__label">Escríbeme</span>
    </a>

    <script>
      function initReveal() {
        const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const els = Array.from(document.querySelectorAll<HTMLElement>(".reveal-up"));
        if (reduced || !("IntersectionObserver" in window)) {
          els.forEach((e) => e.classList.add("is-revealed"));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((en) => {
              if (en.isIntersecting) {
                en.target.classList.add("is-revealed");
                io.unobserve(en.target);
              }
            });
          },
          { threshold: 0.14, rootMargin: "0px 0px -8% 0px" }
        );
        els.forEach((e) => io.observe(e));
      }
      const burger = document.querySelector(".snf-burger");
      const nav = document.querySelector(".snf-nav");
      burger?.addEventListener("click", () => {
        nav?.classList.toggle("is-open");
      });
      nav?.querySelectorAll("a").forEach((a) =>
        a.addEventListener("click", () => nav.classList.remove("is-open"))
      );
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initReveal);
      } else {
        initReveal();
      }
    </script>
  </body>
</html>
